{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gambit-demo",
  "account_id": "f295298e672ac7be3bc6ba969a57dbab",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "GAMBIT_INTERPRETATION_MODEL": "gpt-6.1-sol",
    "GAMBIT_EXECUTION_MODEL": "gpt-6.1-sol",
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "BrowserWorkspace" },
      { "name": "GUARD", "class_name": "UsageGuard" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BrowserWorkspace", "UsageGuard"] },
  ],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
}
