{
  "name": "trade-builder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:integration",
    "review:chat": "node scripts/prepare-chat-atlas.mjs && vite dev --port 3018 --host 127.0.0.1 --strictPort",
    "present:chat": "node scripts/prepare-chat-atlas.mjs && vite dev --port 3020 --host 127.0.0.1 --strictPort",
    "review:record": "node scripts/record-chat-review.mjs",
    "review:refresh": "node scripts/refresh-chat-atlas.mjs",
    "review:verify": "node scripts/prepare-chat-atlas.mjs && node scripts/verify-chat-atlas.mjs",
    "build:cloudflare": "vite build --mode cloudflare",
    "dev:cloudflare": "vite dev --mode cloudflare --port 3019",
    "deploy": "npm run build:cloudflare && wrangler deploy --config dist-cloudflare/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "typecheck:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "test:deployment": "node --import ./scripts/integration-test-setup.mjs --test src/server/cloud-conversation-store.integration.test.ts src/server/conversation-store.integration.test.ts",
    "test:cloudflare-limits": "npm run build:cloudflare && node scripts/check-cloudflare-limits.mjs",
    "test:adk-worker": "npm run build:cloudflare && node scripts/check-adk-worker.mjs",
    "test:integration": "node --import ./scripts/integration-test-setup.mjs --test src/server/*.integration.test.ts",
    "test:chat:live": "node scripts/check-trade-chat.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/adk": "^2.2.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "effect": "^4.0.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lexical": "^0.49.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "openai": "^7.32.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "miniflare": "5.20261006.0-alpha",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "wrangler": "^4.148.0"
  }
}
