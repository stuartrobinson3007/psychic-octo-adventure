{
  "$comment": "Design tokens for InvoiceFlow. Source of truth for colors, spacing, typography. components/ui/* must use ONLY these tokens.",
  "color": {
    "brand": {
      "50": "#EEF2FF",
      "500": "#6366F1",
      "600": "#4F46E5",
      "700": "#4338CA"
    },
    "ink": {
      "900": "#0F172A",
      "700": "#334155",
      "500": "#64748B",
      "300": "#CBD5E1",
      "100": "#F1F5F9"
    },
    "status": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#EF4444"
    },
    "surface": {
      "background": "#FFFFFF",
      "subtle": "#F8FAFC"
    }
  },
